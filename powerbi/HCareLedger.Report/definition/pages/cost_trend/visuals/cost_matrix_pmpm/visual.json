{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "cost_matrix_pmpm",
  "position": {
    "x": 20,
    "y": 470,
    "z": 0,
    "width": 800,
    "height": 235,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "dim_date.year",
              "nativeQueryRef": "year"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_service_type"
                    }
                  },
                  "Property": "service_type"
                }
              },
              "queryRef": "dim_service_type.service_type",
              "nativeQueryRef": "service_type"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "PMPM"
                }
              },
              "queryRef": "_Measures.PMPM",
              "nativeQueryRef": "PMPM"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'PMPM by year and service type (total = medical)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
