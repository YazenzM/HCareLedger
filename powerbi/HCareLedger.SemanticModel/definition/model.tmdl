annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table dim_date
ref table dim_service_type
ref table dim_beneficiary_year
ref table dim_provider
ref table dim_diagnosis
ref table fct_claim_line
ref table fct_drug_event
