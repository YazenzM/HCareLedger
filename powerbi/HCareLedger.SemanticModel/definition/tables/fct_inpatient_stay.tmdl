		summarizeBy: none
		sourceColumn: has_readmission_30d

	/// A non-elective stay admitted 1-30 days after this discharge.
	column has_unplanned_readmission_30d
		dataType: boolean
		lineageTag: 37034da7-df2b-5ace-a524-40826f7ae9ef
		summarizeBy: none
		sourceColumn: has_unplanned_readmission_30d

	/// Days from discharge to the next admission within 30 days.
	column days_to_readmission
		dataType: int64
		formatString: #,0
		lineageTag: b6e76577-58e5-5241-9378-1570e484a28a
		summarizeBy: none
		sourceColumn: days_to_readmission

	/// Days from discharge to the next non-elective admission within 30 days.
	column days_to_unplanned_readmission
		dataType: int64
		formatString: #,0
		lineageTag: 11c1d1dd-6432-54ad-a52b-89952e93bb58
		summarizeBy: none
		sourceColumn: days_to_unplanned_readmission

