		dataType: boolean
		lineageTag: b7277c08-d2be-5b31-8177-760d1932efad
		summarizeBy: none
		sourceColumn: esrd_flag

	/// Months with Part A entitlement, derived from monthly buy-in flags.
	column part_a_months
		dataType: int64
		formatString: #,0
		lineageTag: 3f6aec99-32bb-5d1d-834c-6ecbd894c94f
		summarizeBy: none
		sourceColumn: part_a_months

	/// Months with Part B entitlement, derived from monthly buy-in flags.
	column part_b_months
		dataType: int64
		formatString: #,0
		lineageTag: 595f77a7-c4e6-55d7-854b-25bf65d67b8b
		summarizeBy: none
		sourceColumn: part_b_months

	/// Months enrolled in a Part D contract, derived from monthly contract IDs.
	column part_d_months
		dataType: int64
		formatString: #,0
		lineageTag: 8d14b72b-fdb2-5706-8b04-2210bfdfcbc8
