		lineageTag: 434a5406-1d04-534c-b2b2-3dc05d4e10d7
		summarizeBy: none
		sourceColumn: dual_status

	/// Months with Part A and Part B and no HMO; the denominator for medical PMPM.
	column medical_member_months
