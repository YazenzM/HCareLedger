		formatString: #,0
		lineageTag: c54e470a-4237-57e4-a6aa-54a2466a83ee
		summarizeBy: none
		sourceColumn: medical_member_months

	/// Months enrolled in Part D; the denominator for Part D PMPM.
	column rx_member_months
		dataType: int64
		formatString: #,0
		lineageTag: a7a4e87d-0d95-57a7-88b0-3648d19faf96
		summarizeBy: none
		sourceColumn: rx_member_months

