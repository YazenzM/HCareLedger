/// Beneficiary-year dimension: demographics and enrollment summary for one beneficiary in one calendar year. Key -1 = unknown.
table dim_beneficiary_year
	lineageTag: b4c20b86-72d6-5d7c-9880-71c8bcfe7ae4

	/// Surrogate primary key.
	column bene_year_key
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f0d65360-d48b-5e57-b0c9-111957ca2297
		summarizeBy: none
		sourceColumn: bene_year_key

	/// CMS synthetic beneficiary ID (BENE_ID). Natural key together with year.
	column bene_id
		dataType: string
		lineageTag: 9ed826e3-c165-5bcb-beda-a710a634baba
		summarizeBy: none
		sourceColumn: bene_id

	/// Enrollment reference year.
	column year
		dataType: int64
		formatString: 0
		lineageTag: d7bee8f7-d8b3-5348-94fb-3191d8dfa61b
		summarizeBy: none
		sourceColumn: year

	/// Date of birth (constant across years).
	column birth_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 22327f8b-366b-55ab-b49f-5d51e3fc01ab
		summarizeBy: none
		sourceColumn: birth_date

	/// Date of death. Null for every synthetic beneficiary.
	column death_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: c28327c1-1b89-5ad1-8867-ebfabaad0980
		summarizeBy: none
		sourceColumn: death_date

	/// Age on 31 December of the year (AGE_AT_END_REF_YR).
	column age_at_end_of_year
		dataType: int64
		formatString: 0
		lineageTag: 7875432c-18cc-5769-aa0e-a47c88b43bbd
		summarizeBy: none
		sourceColumn: age_at_end_of_year

	/// Age band: Under 65, 65-69, 70-74, 75-79, 80-84, 85+.
	column age_band
		dataType: string
		lineageTag: 2ea85da1-8b45-5186-aa3a-3673f30b33a2
		summarizeBy: none
		sourceColumn: age_band
		sortByColumn: age_band_order

	/// Sort order for age_band (1 = Under 65 ... 6 = 85+).
	column age_band_order
		dataType: int64
		formatString: 0
		lineageTag: fdc262bd-01ab-5884-af8b-013dfd167c48
		summarizeBy: none
		sourceColumn: age_band_order

	/// SEX_IDENT_CD: 1 = male, 2 = female.
	column sex_code
		dataType: string
		lineageTag: 13c50364-9d76-56e1-970f-744322682584
		summarizeBy: none
		sourceColumn: sex_code

	/// Male / Female from SEX_IDENT_CD.
	column sex
		dataType: string
		lineageTag: 864256fd-9df9-5ac6-9faf-13016d7fdfc6
		summarizeBy: none
		sourceColumn: sex

	/// BENE_RACE_CD: 0-6.
	column race_code
		dataType: string
		lineageTag: f8b884b1-fef2-5ea6-80d6-cda8c623a85e
		summarizeBy: none
		sourceColumn: race_code

	/// Race from BENE_RACE_CD.
	column race
		dataType: string
		lineageTag: cf52d531-1add-5b61-9506-18b80759de9c
		summarizeBy: none
		sourceColumn: race

	/// SSA state code of residence.
	column state_code
		dataType: string
		lineageTag: 34f13302-d70d-5597-8e71-9c36781c5d9f
		summarizeBy: none
		sourceColumn: state_code

	/// SSA county code of residence.
	column county_code
		dataType: string
		lineageTag: 6e0fb7f2-5206-5899-acd3-4c0e3a2a14a4
		summarizeBy: none
		sourceColumn: county_code

	/// ENTLMT_RSN_ORIG: 0 = old age, 1 = disability, 2 = ESRD, 3 = disability and ESRD.
	column orig_entitlement_reason_code
		dataType: string
		lineageTag: 8f8c3396-7e23-5281-88fe-960ed1719f24
		summarizeBy: none
		sourceColumn: orig_entitlement_reason_code

	/// Original reason for Medicare entitlement: Old age, Disability, ESRD, Disability and ESRD.
	column orig_entitlement_reason
		dataType: string
		lineageTag: 471e6610-38c9-58c0-86a2-5655de7bcc91
		summarizeBy: none
		sourceColumn: orig_entitlement_reason

