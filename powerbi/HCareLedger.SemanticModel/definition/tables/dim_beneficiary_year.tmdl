				    Typed = Table.TransformColumnTypes(Source, {{"bene_year_key", Int64.Type}, {"bene_id", type text}, {"year", Int64.Type}, {"birth_date", type date}, {"death_date", type date}, {"age_at_end_of_year", Int64.Type}, {"age_band", type text}, {"age_band_order", Int64.Type}, {"sex_code", type text}, {"sex", type text}, {"race_code", type text}, {"race", type text}, {"state_code", type text}, {"county_code", type text}, {"orig_entitlement_reason_code", type text}, {"orig_entitlement_reason", type text}, {"esrd_flag", type logical}, {"part_a_months", Int64.Type}, {"part_b_months", Int64.Type}, {"part_d_months", Int64.Type}, {"dual_months", Int64.Type}, {"is_dual_any_month", type logical}, {"dual_status", type text}, {"medical_member_months", Int64.Type}, {"rx_member_months", Int64.Type}})
				in
